# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# 模型权重（226MB，用 `voice-ctl download` 拉取，不进版本库）
models/

# llama.cpp 运行时与本地小模型（用 `voice-ctl llm --install` / `--download` 拉取）
# 39.8MB 的二进制；打包时由 voice-ctl.spec 收进 exe
llm/

# 打包产物（构建脚本重新生成，不进版本库）
build/
build-full/
build-decision/
build-lite/
build-semantic/
dist/
dist-full/
dist-decision/
dist-new/
dist-full-new/
dist-semantic/
build-*.log
*.pdb

# 临时探针脚本（诊断完就删，别混进版本库）
scripts/_tmp_*.py

# 生成物：测试音频、基准明细
assets/tts/
assets/*.wav
scripts/bench_e2e.json
scripts/probe_asr.out.txt
scripts/_tts_one.ps1

# 运行日志（用户机器上生成，随时可删）
voice-ctl.log
voice-ctl.log.1
config.toml.bak

# 界面截图/冒烟脚本的临时产物
_ui_*.png
_ui_*.bmp
_screen_*.png
_shotcfg/
