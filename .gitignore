# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# 模型权重（226MB，用 `voice-ctl download` 拉取，不进版本库）
models/

# 打包产物（构建脚本重新生成，不进版本库）
build/
dist/
dist-full/
*.pdb

# 生成物：测试音频、基准明细
assets/tts/
assets/*.wav
scripts/bench_e2e.json
scripts/probe_asr.out.txt
scripts/_tts_one.ps1

# 运行日志（用户机器上生成，随时可删）
voice-ctl.log
voice-ctl.log.1
config.toml.bak

# 界面截图/冒烟脚本的临时产物
_ui_*.png
_ui_*.bmp
_screen_*.png
_shotcfg/
